# Example environment file for Agentic-IAM
# Copy to .env and fill with secrets before running in production.

# Core environment
AGENTIC_IAM_ENVIRONMENT=development
AGENTIC_IAM_API_HOST=0.0.0.0
AGENTIC_IAM_API_PORT=8000
AGENTIC_IAM_DASHBOARD_PORT=8501

# Database (Postgres example)
# Format: postgresql://user:password@host:5432/dbname
AGENTIC_IAM_DATABASE_URL=postgresql://agentic_user:agentic_password@postgres:5432/agentic_iam

# Redis
AGENTIC_IAM_REDIS_URL=redis://redis:6379/0

# Secrets - CHANGE BEFORE PRODUCTION
AGENTIC_IAM_SECRET_KEY=change-me-to-a-random-secret
AGENTIC_IAM_ENCRYPTION_KEY=change-me-32chars-long-or-use-kms
AGENTIC_IAM_JWT_SECRET_KEY=change-me-jwt-secret
AGENTIC_IAM_CREDENTIAL_ENCRYPTION_KEY=change-me-32chars

# Feature flags
AGENTIC_IAM_ENABLE_TRUST_SCORING=true
AGENTIC_IAM_ENABLE_AUDIT_LOGGING=true
AGENTIC_IAM_ENABLE_MFA=true
AGENTIC_IAM_ENABLE_FEDERATED_AUTH=false

# Logging / Performance
AGENTIC_IAM_LOG_LEVEL=INFO
AGENTIC_IAM_LOG_FILE=/app/logs/agentic_iam.log
AGENTIC_IAM_RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# Monitoring
AGENTIC_IAM_ENABLE_METRICS=true
AGENTIC_IAM_PROMETHEUS_ENABLED=true

# Optional integrations (uncomment and set if used)
# SENTRY_DSN=
# PROMETHEUS_SCRAPE_INTERVAL=15s

# Legacy / convenience mappings (some scripts may still read these)
# DATABASE_URL can map to AGENTIC_IAM_DATABASE_URL
# REDIS_URL can map to AGENTIC_IAM_REDIS_URL

# Environment
ENVIRONMENT=development
IS_PRODUCTION=false

# Debug
DEBUG=true
